{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    
"rootDir": "./apps",


    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "**/*.ts"],
  "exclude": ["node_modules"]
}
