generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ─────────────────────────────────────────────
//  ORGANISATION & USER MODELS
// ─────────────────────────────────────────────
//

model org_tenants {
  id         String       @id @default(uuid())
  name       String
  created_at DateTime     @default(now())

  users      org_users[]
}

model org_users {
  id         String       @id @default(uuid())
  tenant_id  String
  email      String
  role       String
  created_at DateTime     @default(now())

  tenant     org_tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Flow 6: actor sessions
  sessions   sessions[]

  // Billing module: merchant fee configuration
  merchant_fees merchant_fees[]
}

//
// ─────────────────────────────────────────────
//  MOBILE USERS
// ─────────────────────────────────────────────
//

model mobile_users {
  id            String    @id @default(uuid())
  mobile_number String
  country_code  String
  created_at    DateTime  @default(now())
}

//
// ─────────────────────────────────────────────
//  QR CODE MODEL
// ─────────────────────────────────────────────
//

model qr_codes {
  id          String    @id @default(uuid())
  owner_type  String
  owner_id    String
  payload     Json
  signature   String
  created_at  DateTime  @default(now())
  expires_at  DateTime?
}

//
// ─────────────────────────────────────────────
//  AUDIT LOGS
// ─────────────────────────────────────────────
//

model audit_logs {
  id         String    @id @default(uuid())
  actor_id   String?
  actor_type String?
  action     String
  metadata   Json?
  created_at DateTime  @default(now())
}

//
// ─────────────────────────────────────────────
//  SESSION MODELS
// ─────────────────────────────────────────────
//

model sessions {
  id         String    @id @default(uuid())
  actor_id   String
  role       String
  state      String
  metadata   Json?
  created_at DateTime  @default(now())
  expires_at DateTime?

  // Flow 6: identity layer
  actor      org_users @relation(fields: [actor_id], references: [id], onDelete: Cascade)
}

model identity_sessions {
  id          String   @id @default(uuid())
  role        String
  merchantId  String?
  state       String   @default("active")
  metadata    Json?
  created_at  DateTime @default(now())
  expires_at  DateTime

  @@map("identity_sessions")
}

//
// ─────────────────────────────────────────────
//  BILLING MODULE — MERCHANT FEES
// ─────────────────────────────────────────────
//

model merchant_fees {
  id             String   @id @default(uuid())
  merchant_id    String
  percentage_fee Float    @default(0)
  fixed_fee      Float    @default(0)
  resource_fee   Float    @default(0)
  created_at     DateTime @default(now())

  merchant org_users @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
}
