generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ─────────────────────────────────────────────
//  ORGANISATION & MERCHANT DOMAIN
// ─────────────────────────────────────────────
//

model org_tenants {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())

  users org_users[]
}

model org_users {
  id         String   @id @default(uuid())
  tenant_id  String
  email      String
  role       String
  created_at DateTime @default(now())

  tenant org_tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Flow 6 identity layer
  sessions sessions[]

  // Billing module
  merchant_fees merchant_fees[]
  payments      payments[]
}

//
// ─────────────────────────────────────────────
//  MOBILE CONSUMER DOMAIN
// ─────────────────────────────────────────────
//

model mobile_users {
  id            String   @id @default(uuid())
  mobile_number String   @unique
  country_code  String
  created_at    DateTime @default(now())

  devices  mobile_devices[]
  sessions mobile_sessions[]
}

model mobile_devices {
  id         String   @id @default(uuid())
  user_id    String
  device_id  String
  platform   String
  push_token String?
  last_seen  DateTime @default(now())
  created_at DateTime @default(now())

  user mobile_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  sessions mobile_sessions[]

  @@index([device_id])
}

model mobile_sessions {
  id            String    @id @default(uuid())
  user_id       String
  device_id     String
  session_token String    @unique
  state         String    @default("active")
  metadata      Json?
  created_at    DateTime  @default(now())
  expires_at    DateTime?

  user   mobile_users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device mobile_devices @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([session_token])
}

//
// ─────────────────────────────────────────────
//  QR CODE DOMAIN
// ─────────────────────────────────────────────
//

model qr_codes {
  id         String    @id @default(uuid())
  owner_type String
  owner_id   String
  payload    Json
  signature  String
  created_at DateTime  @default(now())
  expires_at DateTime?
}

//
// ─────────────────────────────────────────────
//  AUDIT LOGS
// ─────────────────────────────────────────────
//

model audit_logs {
  id         String   @id @default(uuid())
  actor_id   String?
  actor_type String?
  action     String
  metadata   Json?
  created_at DateTime @default(now())
}

//
// ─────────────────────────────────────────────
//  IDENTITY & SESSION MODELS
// ─────────────────────────────────────────────
//

model sessions {
  id         String    @id @default(uuid())
  actor_id   String
  role       String
  state      String
  metadata   Json?
  created_at DateTime  @default(now())
  expires_at DateTime?

  actor org_users @relation(fields: [actor_id], references: [id], onDelete: Cascade)
}

//
// ⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐
//  FLOW‑10 — IDENTITY SESSION STORE (CORRECTED)
// ⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐
//

model identity_sessions {
  session_id   String   @id
  actor_id     String
  badge_id     String?
  device_id    String?
  merchant_id  String?

  role         String?
  state        String
  risk_state   String

  created_at   DateTime
  expires_at   DateTime

  source       String
  metadata     Json?

  payments     payments[]

  @@index([actor_id, state])
  @@index([badge_id, device_id, merchant_id])
  @@index([merchant_id, created_at])

  @@map("identity_sessions")
}


//
// ─────────────────────────────────────────────
//  BILLING MODULE — MERCHANT FEES
// ─────────────────────────────────────────────
//

model merchant_fees {
  id             String   @id @default(uuid())
  merchant_id    String
  percentage_fee Float    @default(0)
  fixed_fee      Float    @default(0)
  resource_fee   Float    @default(0)
  created_at     DateTime @default(now())

  merchant org_users @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
}

model payments {
  id          String   @id @default(uuid())
  identity_id String
  merchant_id String
  amount      Decimal
  currency    String   @default("GBP")
  status      String   @default("pending")
  metadata    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  identity identity_sessions @relation(fields: [identity_id], references: [session_id], onDelete: Cascade)
  merchant org_users         @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([identity_id])
  @@index([merchant_id])
}

