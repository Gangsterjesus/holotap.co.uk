
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model org_tenants {
  id         String       @id @default(uuid())
  name       String
  created_at DateTime     @default(now())

  users      org_users[]
}

model org_users {
  id         String       @id @default(uuid())
  tenant_id  String
  email      String
  role       String
  created_at DateTime     @default(now())

  tenant     org_tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // Flow 6: actor sessions
  sessions   sessions[]
}

model mobile_users {
  id            String    @id @default(uuid())
  mobile_number String
  country_code  String
  created_at    DateTime  @default(now())
}

model qr_codes {
  id          String    @id @default(uuid())
  owner_type  String
  owner_id    String
  payload     Json
  signature   String
  created_at  DateTime  @default(now())
  expires_at  DateTime?
}

model audit_logs {
  id         String    @id @default(uuid())
  actor_id   String?
  actor_type String?
  action     String
  metadata   Json?
  created_at DateTime  @default(now())
}

model sessions {
  id         String    @id @default(uuid())
  actor_id   String
  role       String
  state      String
  metadata   Json?
  created_at DateTime  @default(now())
  expires_at DateTime?

  // Flow 6: identity layer
  actor      org_users @relation(fields: [actor_id], references: [id], onDelete: Cascade)
}

model identity_sessions {
  id          String   @id @default(uuid())
  role        String
  merchantId  String?
  state       String   @default("active")
  metadata    Json?
  created_at  DateTime @default(now())
  expires_at  DateTime

  @@map("identity_sessions")
}
